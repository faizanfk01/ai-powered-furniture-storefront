# Committed template. Copy to `.env` and fill in real values.
# `.env` itself is gitignored — never commit real credentials.

# Neon Postgres — pooled host (contains `-pooler`). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Postgres — direct host (no `-pooler`). Used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# Auth.js (next-auth v5)
# ---------------------------------------------------------------------------

# Signs and encrypts the session JWT. Auth.js reads this name automatically —
# v5 uses AUTH_SECRET (v4's NEXTAUTH_SECRET still works as a fallback).
# Required in production; without it Auth.js throws MissingSecretError.
# Generate one with:  npx auth secret     (or: openssl rand -base64 32)
# Rotating it signs every existing session out.
AUTH_SECRET="replace-me-with-32-random-bytes-base64"

# Only needed if the deployed origin cannot be inferred from the request
# (most hosts, Vercel included, infer it). Leave unset for local development.
# AUTH_URL="https://example.com"

# ---------------------------------------------------------------------------
# Admin bootstrap — `npm run create-admin`
# ---------------------------------------------------------------------------
# Optional, and only for a non-interactive run. Leave these unset and the
# script prompts instead, reading the password without echoing it. Do not
# commit real values here.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Cloudflare R2 — product image storage
# ---------------------------------------------------------------------------
# From the Cloudflare dashboard: R2 > Manage API Tokens (keys) and the bucket
# settings page (account id, endpoint, public r2.dev URL). All six are
# required — lib/r2.ts throws at startup naming any that are missing.
# The secret access key is shown once at creation. Do not commit real values.

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# S3-compatible API endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""

R2_BUCKET_NAME=""

# Public origin images are served from. Either the bucket's r2.dev domain
# (https://pub-<hash>.r2.dev) or a custom domain bound to the bucket.
# No trailing slash.
R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Groq — the storefront assistant (Phase 3)
# ---------------------------------------------------------------------------
# Free tier, no card required: console.groq.com > API Keys > Create API Key.
# Shown once at creation. Do not commit a real key.
#
# Optional in the sense that the site runs without it — the assistant degrades
# to "message us on WhatsApp" (HTTP 503, code AI_UNAVAILABLE) rather than
# breaking a page. Required for the assistant to answer anything.
#
# MODEL AVAILABILITY IS NOT WHAT THE DOCS SAY. On 2026-08-27 Groq's own model
# page still listed llama-3.3-70b-versatile and llama-3.1-8b-instant as current
# production models; both returned 404 model_not_found on a real free-tier key.
# Check the API, not the documentation, before changing a model id:
#
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#
# Limits are per ORGANISATION, not per key, so extra keys buy nothing. Measured
# from the x-ratelimit-* response headers on 2026-08-27, for the two models
# lib/ai/groq.ts uses:
#   openai/gpt-oss-20b    1,000 requests/day | 8,000 tokens/minute
#   openai/gpt-oss-120b   1,000 requests/day | 8,000 tokens/minute
# Hitting either returns HTTP 429, which the chat route turns into code AI_BUSY
# and passes Groq's own `retry-after` through.
GROQ_API_KEY=""

# Optional. Overrides the API base URL (default https://api.groq.com/openai/v1).
# Exists so `npm run test:chat` can aim the app at the local stub in
# scripts/groq-stub.ts and exercise the 429 and hallucination paths on demand.
# Leave unset everywhere else.
# GROQ_BASE_URL="http://127.0.0.1:4599/v1"

# ---------------------------------------------------------------------------
# Public site origin
# ---------------------------------------------------------------------------
# Optional. Sets the canonical origin used in absolute links — notably the
# WhatsApp enquiry prefill, which carries a link into someone else's chat app.
# Leave unset and the origin is taken from the incoming request, which is
# correct for local development and preview deployments. Set it in production
# so a proxy's host header cannot change what customers are sent.
# NEXT_PUBLIC_SITE_URL="https://standardfurniture.pk"

# ---------------------------------------------------------------------------
# Upstash Redis — per-IP rate limiting
# ---------------------------------------------------------------------------
# The REST credentials from the Upstash console (Database -> REST API). Both
# are required; lib/rate-limit.ts reads them explicitly rather than through
# Redis.fromEnv(), which throws when they are absent.
#
# PLACEHOLDERS ONLY IN THIS FILE. The real values live in .env, which is
# gitignored and must never be committed.
#
# The token is a bearer credential for the whole database — SERVER-ONLY. Never
# prefix either of these with NEXT_PUBLIC_: that would ship a writable Redis
# credential to every visitor's browser.
#
# Leaving them unset does not break the app. Rate limiting degrades to
# "allowed" with a warning on boot, and login keeps a per-instance in-process
# backstop. That is a development convenience, not a deployment posture — set
# both in production. Limits enforced when they are set:
#   login    5 / 15 min per IP   (brute force)
#   chat    15 / 1 min  per IP   (Groq quota)
#   review   4 / 1 hour per IP   (spam)
#   presign 30 / 1 min  per IP   (R2 upload abuse)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
